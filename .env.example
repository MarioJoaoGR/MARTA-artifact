# Copy to .env before running. These are the values used in the evaluation.

# Model served locally through Ollama (or any OpenAI-compatible endpoint)
MODEL='deepseek-coder-v2:16b'
OPENAI_API_BASE='http://localhost:11434/v1'
OPENAI_API_KEY='ollama'

# Sentence embedder for the retrieval-augmented context (Phase 1)
TRANSFORMER_PATH='BAAI/bge-large-en-v1.5'

# Python interpreter used to run the generated tests
USER_PYTHON_PATH='python3'

# Set to 'cpu' to keep the GPU free for the language model
EMBED_DEVICE='cpu'
