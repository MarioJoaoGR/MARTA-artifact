+    @classmethod
+    def load_existing(cls, test_manager, func, test_path: str):
+        """Referencia um ficheiro de teste já existente em disco sem o
+        sobrescrever. Usado para retomar runs interrompidas (ex. SLURM 48h)
+        sem voltar a invocar o LLM."""
+        instance = cls.__new__(cls)
+        instance.test_manager = test_manager
+        instance.test_path = test_path
+        instance.func = func
+        instance.error_message = ""
+        return instance
+
     def delete(self):
         try:
             os.remove(self.test_path)
@@ -271,7 +293,11 @@ class Testcase:
             f.write(code)
 
     def find_syntax_error(self):
-        root_dir = self.func.file.root_dir
+        # import_root: nos containers (ansible/lib, black/src) o pylint precisa da
+        # raiz de import correta — com root_dir acusava import-error (E0401) e
+        # rejeitava testes válidos antes de chegarem ao pytest. == root_dir nos
+        # 25 projetos normais.
+        root_dir = getattr(self.func.file.project, 'import_root', self.func.file.root_dir)
         user_python_path = os.getenv('USER_PYTHON_PATH')
         command = f'PYTHONPATH={root_dir} {user_python_path} -m pylint --errors-only --init-hook="import sys; sys.path.append(\'{root_dir}\')" {self.test_path}'
 
