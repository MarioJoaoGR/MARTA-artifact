+    @classmethod
+    def load_existing(cls, test_manager, func, test_path: str):
+        """Referencia um ficheiro de teste já existente em disco sem o
+        sobrescrever. Usado para retomar runs interrompidas (ex. SLURM 48h)
+        sem voltar a invocar o LLM."""
+        instance = cls.__new__(cls)
+        instance.test_manager = test_manager
+        instance.test_path = test_path
+        instance.func = func
+        instance.error_message = ""
+        return instance
+
     def delete(self):
         try:
             os.remove(self.test_path)
diff --git a/test4dt/utils.py b/test4dt/utils.py
index 1748380..787cf08 100644
--- a/test4dt/utils.py
+++ b/test4dt/utils.py
@@ -2,6 +2,22 @@ import ast
 import os
 
 
+def get_output_root(root_dir: str) -> str:
+    """Devolve a pasta-base onde devem ser escritos os outputs.
+
+    Se ``config.output_dir`` estiver definido (via --output_dir), devolve
+    ``{config.output_dir}/{project_name}/``. Caso contrário devolve ``root_dir``
+    (legacy: escreve dentro do source do projeto).
+    """
+    from test4dt.config import config
+    if config.output_dir:
+        project_name = os.path.basename(root_dir.rstrip(os.path.sep))
+        path = os.path.join(config.output_dir, project_name)
+        os.makedirs(path, exist_ok=True)
+        return path
+    return root_dir
+
+
 def get_code(code: str):
     if len(code.split('```')) < 3:
         return code
